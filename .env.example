# QuickAI Environment Configuration
# Copy this file to .env and adjust values as needed.
#
#   copy .env.example .env
#
# Only the VITE_-prefixed variables below are read by QuickAI at build/dev time
# (via `import.meta.env` in the frontend). Everything else is configured in the
# app:
#   - Providers, models, base URLs, and API keys: Settings window (AI / Agent tabs)
#   - System prompt, window geometry, quote limits: config.toml (Settings window)
# See docs/configurations.md for the full reference.

# ── Quote Display ────────────────────────────────────────────────────────────
# Controls how selected-text quotes are displayed in the AskBar and chat bubbles.

# Maximum number of lines shown in the quote preview.
VITE_QUOTE_MAX_DISPLAY_LINES=4

# Maximum total characters shown in the quote preview.
VITE_QUOTE_MAX_DISPLAY_CHARS=300

# Maximum length of selected context text included in the prompt sent to the
# model. Longer selections are silently truncated.
VITE_QUOTE_MAX_CONTEXT_LENGTH=4096

# ── Build metadata (set by CI, not by hand) ──────────────────────────────────
# Short git commit SHA shown on the Settings → About tab.
# VITE_GIT_COMMIT_SHA=
